# CineBook Frontend Environment Variables
# Use this file for local development and add your actual values.

# If your API is served from a different host, set it here.
# In development, Vite defaults to proxying /api to localhost:5000.
VITE_API_BASE_URL="http://localhost:5000/api/v1"

# Google OAuth Client ID for Google Sign-In.
# Create this in Google Cloud Console and use the Web application client ID.
VITE_GOOGLE_CLIENT_ID="your_google_client_id"
